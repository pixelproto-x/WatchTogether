rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chatMedia/{uidA}/{uidB}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uidA || request.auth.uid == uidB);
      allow write: if request.auth != null
        && (request.auth.uid == uidA || request.auth.uid == uidB)
        && request.resource.size <= 10485760
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp', 'image/gif',
          'audio/mpeg', 'audio/mp4', 'audio/ogg', 'audio/webm', 'audio/wav'
        ];
      allow delete: if request.auth != null
        && (request.auth.uid == uidA || request.auth.uid == uidB);
    }
  }

  // Legacy room-media path is not used by the current client. Deny by default:
  // its old rule allowed every signed-in account to read every room's uploads.
  match /chatRoomMedia/{roomId}/{uid}/{fileName} {
    allow read, write, delete: if false;
  }
}
